{
  "title": "Roadie shortcuts",
  "rules": [
    {
      "description": "Roadie: focus left (option + h)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "h",
            "modifiers": {
              "mandatory": [
                "option"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "shell_command": "$HOME/.local/bin/roadie focus left"
            }
          ]
        }
      ]
    },
    {
      "description": "Roadie: focus down (option + j)",
