#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
label="com.roadie.roadied"
plist="$HOME/Library/LaunchAgents/$label.plist"
log_dir="$HOME/.roadies"
# Les binaires installés vivent hors du dépôt : le LaunchAgent ne dépend pas du dossier source.
local_bin_dir="$HOME/.local/bin"
# Le daemon tourne depuis Roadie.app : macOS l'affiche alors sous le nom « Roadie » avec son
# icône dans Accessibilité, au lieu d'un binaire nu présenté comme un terminal.
app_bundle="$HOME/Applications/Roadie.app"
app_roadied="$app_bundle/Contents/MacOS/roadied"

# Identité de signature stable (ex. "Apple Development: Nom (ID)"). macOS lie la permission
# Accessibility à la signature : avec la signature ad hoc, elle est perdue à chaque installation.
codesign_identity="${ROADIE_CODESIGN_IDENTITY:-}"
if [[ -n "$codesign_identity" ]]; then
  if ! security find-identity -v -p codesigning | grep -qF "$codesign_identity"; then
    echo "ROADIE_CODESIGN_IDENTITY introuvable dans le trousseau : $codesign_identity" >&2
    echo "Liste des identités disponibles : security find-identity -v -p codesigning" >&2
    exit 1
  fi
else
  echo "ATTENTION : ROADIE_CODESIGN_IDENTITY n'est pas défini, signature ad hoc." >&2
  echo "  macOS oubliera la permission Accessibility de roadied à chaque nouvelle installation." >&2
  echo "  Définissez ROADIE_CODESIGN_IDENTITY pour une signature stable." >&2
fi

mkdir -p "$log_dir" "$HOME/Library/LaunchAgents" "$local_bin_dir" "$HOME/Applications"

echo "Building Roadie release binaries..."
"$script_dir/with-xcode" swift build --configuration release --product roadied
"$script_dir/with-xcode" swift build --configuration release --product roadie
bin_dir="$("$script_dir/with-xcode" swift build --show-bin-path --configuration release)"

build_roadied="$bin_dir/roadied"
build_roadie="$bin_dir/roadie"
local_roadied="$local_bin_dir/roadied"
local_roadie="$local_bin_dir/roadie"

if [[ ! -x "$build_roadied" ]]; then
  echo "roadied binary not found: $build_roadied" >&2
  exit 1
fi
if [[ ! -x "$build_roadie" ]]; then
  echo "roadie binary not found: $build_roadie" >&2
  exit 1
fi

install_binary() {
  local source="$1"
  local target="$2"
  local tmp="$target.tmp"
  cp "$source" "$tmp"
  chmod +x "$tmp"
  if [[ -n "$codesign_identity" ]]; then
    codesign --force --sign "$codesign_identity" "$tmp"
  else
    codesign --force --sign - "$tmp" >/dev/null 2>&1 || echo "ATTENTION : signature ad hoc impossible pour $target" >&2
  fi
  mv "$tmp" "$target"
}

# Construit et signe l'application à côté, puis remplace l'ancienne d'un coup. Le daemon en cours
# garde l'ancien exécutable ouvert jusqu'à `make restart`.
install_app() {
  local tmp_bundle="$app_bundle.tmp"
  local version
  version="$(sed -n 's/.*static let current = "\(.*\)".*/\1/p' "$script_dir/../Sources/RoadieDaemon/DaemonHealth.swift")"
  "$script_dir/build-app-bundle" "$build_roadied" "$tmp_bundle" "${version:-0.0.0}"
  if [[ -n "$codesign_identity" ]]; then
    codesign --force --sign "$codesign_identity" "$tmp_bundle"
  else
    codesign --force --sign - "$tmp_bundle" >/dev/null 2>&1 || echo "ATTENTION : signature ad hoc impossible pour $app_bundle" >&2
  fi
  rm -rf "$app_bundle"
  mv "$tmp_bundle" "$app_bundle"
}

echo "Installing binaries..."
install_app
# Compatibilité : ~/.local/bin/roadied reste utilisable en ligne de commande.
ln -sfn "$app_roadied" "$local_roadied"
install_binary "$build_roadie" "$local_roadie"

previous_plist="$(cat "$plist" 2>/dev/null || true)"
cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$app_roadied</string>
    <string>run</string>
    <string>--yes</string>
  </array>
  <key>WorkingDirectory</key>
  <string>$HOME</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$log_dir/roadied.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>$log_dir/roadied.stderr.log</string>
</dict>
</plist>
PLIST

echo "Installed:"
echo "  $app_bundle"
echo "  $local_roadied -> $app_roadied"
echo "  $local_roadie"
echo "LaunchAgent:"
echo "  $plist"

if [[ "${ROADIE_INSTALL_NO_START:-0}" == "1" ]]; then
  echo "Start skipped because ROADIE_INSTALL_NO_START=1."
elif command -v tmux >/dev/null 2>&1 && tmux has-session -t roadied 2>/dev/null; then
  echo "Start skipped: a development session (make dev-start) is running."
  echo "Run 'make stop', then 'make restart' (one launcher at a time)."
elif launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
  if [[ "$(cat "$plist")" != "$previous_plist" ]]; then
    # kickstart relance le programme sans relire le plist : il faut décharger puis recharger.
    echo "$label is already loaded with an older LaunchAgent. Run 'make stop && make restart' to apply it."
  else
    echo "$label is already loaded. Run 'make restart' when you want to reload the installed binaries."
  fi
else
  echo "Starting $label..."
  if launchctl bootstrap "gui/$(id -u)" "$plist" >/dev/null 2>&1; then
    # Le log precedent reste lisible en .1 (l'ancien .1 est ecrase).
    for f in "$log_dir/roadied.stdout.log" "$log_dir/roadied.stderr.log"; do
      if [[ -s "$f" ]]; then mv -f "$f" "$f.1"; fi
    done
    launchctl kickstart -k "gui/$(id -u)/$label" >/dev/null 2>&1 || true
    echo "$label started."
  else
    echo "LaunchAgent installed but not started."
    echo "Start manually with:"
    echo "  launchctl bootstrap gui/$(id -u) \"$plist\""
  fi
fi

echo "Next checks:"
echo "  make status"
echo "  roadie daemon health"
