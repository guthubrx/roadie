#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
dist_dir="$repo_root/dist"
app_name="Roadie"
app_version="${ROADIE_VERSION:-0.12.0}"
app_bundle="$dist_dir/$app_name.app"
dmg_path="$dist_dir/$app_name.dmg"

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "Outil manquant : $1. $2" >&2
    exit 69
  }
}
require create-dmg "Installez-le avec : brew install create-dmg"
require sips "Outil système macOS introuvable."
require iconutil "Outil système macOS introuvable."
require codesign "Installez les Command Line Tools : xcode-select --install"

cd "$repo_root"
rm -rf "$dist_dir"
mkdir -p "$dist_dir"

"$script_dir/with-xcode" swift build --configuration release --product roadied
"$script_dir/with-xcode" swift build --configuration release --product roadie
bin_dir="$("$script_dir/with-xcode" swift build --show-bin-path --configuration release)"

"$script_dir/build-app-bundle" "$bin_dir/roadied" "$app_bundle" "$app_version"
cp "$bin_dir/roadie" "$app_bundle/Contents/Resources/roadie"
chmod +x "$app_bundle/Contents/Resources/roadie"

codesign --force --deep --sign - "$app_bundle" >/dev/null

create-dmg \
  --volname "$app_name" \
  --volicon "$app_bundle/Contents/Resources/Roadie.icns" \
  --window-pos 200 120 \
  --window-size 640 420 \
  --icon-size 112 \
  --icon "$app_name.app" 170 190 \
  --app-drop-link 470 190 \
  --hide-extension "$app_name.app" \
  "$dmg_path" \
  "$dist_dir"

(
  cd "$dist_dir"
  shasum -a 256 "$app_name.dmg" > "$app_name.dmg.sha256"
)

echo "$dmg_path"
