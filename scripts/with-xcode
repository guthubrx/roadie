#!/usr/bin/env bash
# Exécute une commande avec une chaîne d'outils Swift propre et connue.
# Xcode.app est utilisé s'il est installé, sinon les Command Line Tools.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ $# -eq 0 ]]; then
  echo "usage: $(basename "$0") COMMANDE [ARGUMENTS...]" >&2
  exit 64
fi

xcode_developer_dir="/Applications/Xcode.app/Contents/Developer"
if [[ -d "$xcode_developer_dir" ]]; then
  developer_dir="$xcode_developer_dir"
elif developer_dir="$(xcode-select -p 2>/dev/null)" && [[ -n "$developer_dir" ]]; then
  :
else
  developer_dir=""
fi

# xcrun trouve swift dans Xcode (Toolchains/) comme dans les Command Line Tools (usr/bin/).
if [[ -z "$developer_dir" ]] || ! DEVELOPER_DIR="$developer_dir" /usr/bin/xcrun --find swift >/dev/null 2>&1; then
  echo "Aucune chaîne d'outils Swift trouvée (ni Xcode.app, ni Command Line Tools)." >&2
  echo "Installez les Command Line Tools avec : xcode-select --install" >&2
  exit 69
fi

export DEVELOPER_DIR="$developer_dir"
# /usr/local/bin et /opt/homebrew/bin : outils Homebrew (tmux, create-dmg) sur Intel et Apple Silicon.
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin"

unset SDKROOT
unset CC
unset CXX
unset LD
unset LDFLAGS
unset CFLAGS
unset CXXFLAGS
unset CPPFLAGS
unset LIBRARY_PATH
unset CPATH
unset DYLD_LIBRARY_PATH
unset DYLD_FRAMEWORK_PATH

cd "$repo_root"
exec "$@"
