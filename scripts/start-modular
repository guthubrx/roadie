#!/usr/bin/env bash
# Lance chaque composant Roadie dans une session tmux dediee.
# Pattern atomique SPEC-011 : permet de killer/relancer un composant sans
# toucher aux autres. Pour le mode legacy monolithique, utiliser Scripts/start.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
log_dir="$HOME/.roadies"
runtime_bin_dir="$repo_root/bin"
local_bin_dir="$HOME/.local/bin"

mkdir -p "$log_dir" "$runtime_bin_dir" "$local_bin_dir"

# Build une seule fois pour tous les composants.
"$script_dir/with-xcode" swift build --configuration debug --product roadied
"$script_dir/with-xcode" swift build --configuration debug --product roadie
bin_dir="$("$script_dir/with-xcode" swift build --show-bin-path --configuration debug)"
cp "$bin_dir/roadied" "$runtime_bin_dir/roadied"
cp "$bin_dir/roadie" "$runtime_bin_dir/roadie"
cp "$bin_dir/roadied" "$local_bin_dir/roadied"
cp "$bin_dir/roadie" "$local_bin_dir/roadie"
chmod +x "$runtime_bin_dir/roadied" "$runtime_bin_dir/roadie" "$local_bin_dir/roadied" "$local_bin_dir/roadie"
codesign --force --sign - "$runtime_bin_dir/roadied" >/dev/null 2>&1 || true
codesign --force --sign - "$runtime_bin_dir/roadie" >/dev/null 2>&1 || true
codesign --force --sign - "$local_bin_dir/roadied" >/dev/null 2>&1 || true
codesign --force --sign - "$local_bin_dir/roadie" >/dev/null 2>&1 || true

# Liste des composants a lancer. Pour exclure un composant, retirer sa ligne.
COMPONENTS=(
  "tiler:run-tiler --yes"
  "rail:run-rail"
  "border:run-border"
  "focus-mouse:run-focus-mouse"
  "titlebar-menu:run-titlebar-menu"
  "target-mode:run-target-mode"
  "restore-safety:run-restore-safety"
)

launch_component() {
  local name="$1"
  local args="$2"
  local session="roadie-${name}"
  local stdout_log="$log_dir/${name}.stdout.log"
  local stderr_log="$log_dir/${name}.stderr.log"
  local pid_file="$log_dir/${name}.pid"

  # Tuer ancienne session si elle existe, mais pas le composant lui-meme.
  tmux kill-session -t "$session" 2>/dev/null || true
  for _ in {1..50}; do
    if [[ ! -f "$pid_file" ]]; then
      break
    fi
    local pid
    pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$pid_file"
      break
    fi
    sleep 0.1
  done
  : > "$stdout_log"
  : > "$stderr_log"

  # Note : on traduit "tiler" -> "tiler" (les sous-commandes roadied sont tiler|rail|etc.)
  local subcommand="$name"
  local extra_args=""
  if [[ "$name" == "tiler" ]]; then
    extra_args="--yes"
  fi
  tmux new-session -d -s "$session" \
    "cd '$repo_root' && exec '$runtime_bin_dir/roadied' $subcommand $extra_args >> '$stdout_log' 2>> '$stderr_log'"

  echo "$name launched (session=$session, logs=$stdout_log $stderr_log)"
}

for spec in "${COMPONENTS[@]}"; do
  name="${spec%%:*}"
  args="${spec#*:}"
  launch_component "$name" "$args"
done

echo ""
echo "roadie status: \$ roadie query components"
echo "stop one:     \$ tmux kill-session -t roadie-<NAME>"
echo "stop all:     \$ for s in \$(tmux ls -F '#S' | grep ^roadie-); do tmux kill-session -t \$s; done"
