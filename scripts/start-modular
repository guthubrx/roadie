#!/usr/bin/env bash
# Lance chaque composant Roadie dans une session tmux dediee.
# Pattern atomique SPEC-011 : permet de killer/relancer un composant sans
# toucher aux autres. Pour le mode legacy monolithique, utiliser Scripts/start.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
log_dir="$HOME/.roadies"
runtime_bin_dir="$repo_root/bin"

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "Outil manquant : $1. $2" >&2
    exit 69
  }
}
require tmux "Installez-le avec : brew install tmux"
require codesign "Installez les Command Line Tools : xcode-select --install"

mkdir -p "$log_dir" "$runtime_bin_dir"

# Développement : les binaires restent dans ./bin. Ceux de `make install` (~/.local/bin) ne sont pas touchés.
# Build une seule fois pour tous les composants.
"$script_dir/with-xcode" swift build --configuration debug --product roadied
"$script_dir/with-xcode" swift build --configuration debug --product roadie
bin_dir="$("$script_dir/with-xcode" swift build --show-bin-path --configuration debug)"
cp "$bin_dir/roadied" "$runtime_bin_dir/roadied"
cp "$bin_dir/roadie" "$runtime_bin_dir/roadie"
chmod +x "$runtime_bin_dir/roadied" "$runtime_bin_dir/roadie"
codesign --force --sign - "$runtime_bin_dir/roadied" >/dev/null 2>&1 || true
codesign --force --sign - "$runtime_bin_dir/roadie" >/dev/null 2>&1 || true

# Un seul lanceur à la fois : le LaunchAgent (KeepAlive) relancerait en boucle un tiler refusé
# par le verrou d'instance. On le décharge avant de lancer les composants.
label="com.roadie.roadied"
if launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
  launchctl bootout "gui/$(id -u)/$label"
  echo "$label déchargé (utilisez 'make restart' pour le relancer)"
fi
if command -v tmux >/dev/null 2>&1 && tmux has-session -t roadied 2>/dev/null; then
  echo "La session tmux 'roadied' (make dev-start) tourne. Lancez 'make stop' d'abord." >&2
  exit 1
fi

# Liste des composants a lancer. Pour exclure un composant, retirer sa ligne.
COMPONENTS=(
  "tiler:run-tiler --yes"
  "rail:run-rail"
  "border:run-border"
  "focus-mouse:run-focus-mouse"
  "titlebar-menu:run-titlebar-menu"
  "target-mode:run-target-mode"
)
# La sécurité de restauration vit dans `roadied tiler` (et `run`) : ce n'est plus un composant.

launch_component() {
  local name="$1"
  local args="$2"
  local session="roadie-${name}"
  local stdout_log="$log_dir/${name}.stdout.log"
  local stderr_log="$log_dir/${name}.stderr.log"
  # Le tiler écrit roadied.pid (verrou d'instance partagé avec `roadied run`), les autres <nom>.pid.
  local pid_file="$log_dir/${name}.pid"
  if [[ "$name" == "tiler" ]]; then
    pid_file="$log_dir/roadied.pid"
  fi

  # Tuer ancienne session si elle existe, mais pas le composant lui-meme.
  tmux kill-session -t "$session" 2>/dev/null || true
  for _ in {1..50}; do
    if [[ ! -f "$pid_file" ]]; then
      break
    fi
    local pid
    pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$pid_file"
      break
    fi
    sleep 0.1
  done
  # Rotation d'une génération : le log précédent reste lisible en .1.
  for log in "$stdout_log" "$stderr_log"; do
    [[ -s "$log" ]] && mv -f "$log" "$log.1"
    : > "$log"
  done

  # Note : on traduit "tiler" -> "tiler" (les sous-commandes roadied sont tiler|rail|etc.)
  local subcommand="$name"
  local extra_args=""
  if [[ "$name" == "tiler" ]]; then
    extra_args="--yes"
  fi
  tmux new-session -d -s "$session" \
    "cd '$repo_root' && exec '$runtime_bin_dir/roadied' $subcommand $extra_args >> '$stdout_log' 2>> '$stderr_log'"

  echo "$name launched (session=$session, logs=$stdout_log $stderr_log)"
}

for spec in "${COMPONENTS[@]}"; do
  name="${spec%%:*}"
  args="${spec#*:}"
  launch_component "$name" "$args"
done

echo ""
echo "roadie status: \$ roadie query components"
echo "stop one:     \$ tmux kill-session -t roadie-<NAME>"
echo "stop all:     \$ for s in \$(tmux ls -F '#S' | grep ^roadie-); do tmux kill-session -t \$s; done"
