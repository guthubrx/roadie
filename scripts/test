#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tmp_home="$(mktemp -d "${TMPDIR:-/tmp}/roadie-test-home.XXXXXX")"
cleanup() {
  rm -rf "$tmp_home"
}
trap cleanup EXIT

# Pas de `exec` (REL-041) : il remplacerait ce shell et le trap EXIT ne supprimerait jamais tmp_home.
# `set -e` propage le code de sortie de swift test après le nettoyage.
# Textes de l'interface en français, comme les attendent les tests (session 126).
HOME="$tmp_home" ROADIE_LANGUAGE="${ROADIE_LANGUAGE:-fr}" "$script_dir/with-xcode" swift test "$@"
