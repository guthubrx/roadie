 public enum LayoutPlanner {
     public static func plan(_ request: LayoutRequest) -> LayoutPlan {
-        switch request.mode {
+        let basePlan = planWithoutCollapsedAdjustments(request)
+        guard !request.collapsedWindowHeights.isEmpty else { return basePlan }
+        return applyCollapsedInLayoutHeights(basePlan, request: request)
+    }
+
+    private static func planWithoutCollapsedAdjustments(_ request: LayoutRequest) -> LayoutPlan {
+        var passthrough = request
+        passthrough.collapsedWindowHeights = [:]
+        switch passthrough.mode {
         case .bsp:
-            return BSPLayoutStrategy().plan(request)
+            return BSPLayoutStrategy().plan(passthrough)
         case .mutableBsp:
-            return MutableBSPLayoutStrategy().plan(request)
+            return MutableBSPLayoutStrategy().plan(passthrough)
         case .masterStack:
-            return MasterStackLayoutStrategy().plan(request)
+            return MasterStackLayoutStrategy().plan(passthrough)
         case .float:
-            return FloatLayoutStrategy().plan(request)
+            return FloatLayoutStrategy().plan(passthrough)
+        }
+    }
+
+    private static func applyCollapsedInLayoutHeights(_ basePlan: LayoutPlan, request: LayoutRequest) -> LayoutPlan {
+        let gap = CGFloat(request.innerGap)
+        var placements = basePlan.placements
+        let collapsedIDs = request.windowIDs.filter { request.collapsedWindowHeights[$0] != nil }
+        guard !collapsedIDs.isEmpty else { return basePlan }
+
+        for id in collapsedIDs {
+            guard let original = placements[id] else { continue }
+            let requestedHeight = request.collapsedWindowHeights[id] ?? 28
+            let collapsedHeight = min(max(18, requestedHeight), max(18, original.height))
+            let freedHeight = max(0, original.height - collapsedHeight)
+            let collapsedBand = CGRect(
+                x: original.minX,
+                y: original.minY,
+                width: original.width,
+                height: collapsedHeight
+            ).integral
+            placements[id] = collapsedBand
+            guard freedHeight > 0 else { continue }
+            expandWindowsBelowCollapsed(
+                originalFrame: original,
+                collapsedBand: collapsedBand,
+                freedHeight: freedHeight,
+                gap: gap,
+                collapsedIDs: Set(collapsedIDs),
+                placements: &placements
+            )
         }
+        return LayoutPlan(placements: placements)
+    }
+
+    private static func expandWindowsBelowCollapsed(
+        originalFrame: CGRect,
+        collapsedBand: CGRect,
+        freedHeight: CGFloat,
+        gap: CGFloat,
+        collapsedIDs: Set<WindowID>,
+        placements: inout [WindowID: CGRect]
+    ) {
+        let candidates = placements
+            .filter { id, frame in
+                !collapsedIDs.contains(id) &&
+                    frame.minY >= originalFrame.maxY - 1 &&
+                    horizontalOverlapRatio(frame, originalFrame) >= 0.65
+            }
+            .sorted { $0.value.minY < $1.value.minY }
+        guard let target = candidates.first else { return }
+        let current = target.value
+        let newY = max(collapsedBand.maxY + gap, current.minY - freedHeight)
+        placements[target.key] = CGRect(
+            x: current.minX,
+            y: newY,
+            width: current.width,
+            height: max(18, current.maxY - newY)
+        ).integral
+    }
+
+    private static func horizontalOverlapRatio(_ first: CGRect, _ second: CGRect) -> CGFloat {
+        let overlap = max(0, min(first.maxX, second.maxX) - max(first.minX, second.minX))
+        let base = max(1, min(first.width, second.width))
+        return overlap / base
     }
 }
 
