      "file": "specs/155-consolidation-projet/gabarits/tests.yml",
      "line": 16,
      "symbol": "à-qualifier",
      "instance": "candidate-line-16",
      "category": "security",
      "title": "GitHub Actions step uses a mutable tag or branch reference. Tags and branch names can be silently repointed by the action owner, enabling supply-chain attacks — as seen in the trivy-action and kics-github-action compromises. Pin the reference to a full 40-character commit SHA instead, e.g. `uses: actions/checkout@8ade135a41bc03ea155e62e844d188df1ea18608`.",
      "severity": "MEDIUM",
      "confidence": "low",
      "status": "candidate",
